# CineLists - Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun

# Kimlik Doğrulama
AUTH_SECRET="rastgele-gizli-dizi-buraya"
NEXTAUTH_SECRET="rastgele-gizli-dizi-buraya"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
# Google Identity Services JavaScript origins:
# http://localhost:3000
# https://cinelists.com
# https://www.cinelists.com
AUTH_GOOGLE_ID="google-client-id-buraya"
AUTH_GOOGLE_SECRET="google-client-secret-buraya"

# Veritabanı
DATABASE_URL="postgresql://kullanici:sifre@host:5432/veritabani?sslmode=require"

# TMDB API
TMDB_API_KEY="tmdb-api-anahtari-buraya"

# Yönetim paneli: yetkili mevcut User.id değerleri, virgülle ayrılır.
# Boş olduğunda hiç kimse yönetim verilerine erişemez.
ADMIN_USER_IDS=""
# Yeni yönetim migration'ı uygulandıktan sonra açın.
ANALYTICS_ENABLED="false"
# Yalnızca reverse proxy'nin dışarıdan gelen değeri silip kendisinin yazdığı
# güvenilir geo başlığını seçin; aksi halde boş bırakın (Bilinmiyor).
# cf-ip-country | x-vercel-ip-country | cloudfront-viewer-country | x-country-code
ANALYTICS_COUNTRY_HEADER=""
