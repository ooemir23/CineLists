generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  username      String   @unique
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  bio           String?   @db.Text
  password      String?
  
  accounts      Account[]
  sessions      Session[]
  
  // Social
  followedBy    Follow[]  @relation("followedBy")
  following     Follow[]  @relation("following")
  
  // App Data
  activities    Activity[]
  comments      Comment[]
  sentRecommendations     Recommendation[] @relation("sentRecommendations")
  receivedRecommendations Recommendation[] @relation("receivedRecommendations")
  
  // Lists
  watched           Watched[]         @relation("UserWatched")
  toWatch           ToWatch[]
  watchedEpisodes   WatchedEpisode[]
  watchedRecommendations Watched[]     @relation("WatchedRecommendations")
  activityRecommendations Activity[]   @relation("ActivityRecommendations")

  // Messaging
  sentMessages     Message[] @relation("sentMessages")
  receivedMessages Message[] @relation("receivedMessages")

  // Onboarding & Preferences
  hasCompletedOnboarding Boolean @default(false)
  favoriteGenres        String[]
  platforms             String[]
  
  // Notifications
  notifications Indicates[]

  // Favorites
  favoritePersons FavoritePerson[]
}

model FavoritePerson {
  id          String   @id @default(cuid())
  userId      String
  tmdbId      Int
  name        String
  profilePath String?
  addedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
}

model Follow {
  followerId String
  followingId String
  follower   User   @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following  User   @relation("followedBy", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// App Core Models

enum MediaType {
  MOVIE
  TV
  PERSON
}

model MediaItem {
  id          String   @id @default(cuid())
  tmdbId      Int      @unique
  type        MediaType
  title       String
  posterPath  String?
  backdropPath String?
  overview    String?  @db.Text
  releaseDate DateTime?
  runtime     Int?     // Runtime in minutes
  seasonCount Int?
  episodeCount Int?
  genres       String[]
  voteAverage  Float?
  
  activities     Activity[]
  watchedBy      Watched[]
  toWatchBy      ToWatch[]
  recommendations Recommendation[]
  episodes       Episode[]
}

model Watched {
  id              String      @id @default(cuid())
  userId          String
  mediaId         String
  rating          Float?      // User's rating 0-10
  watchedAt       DateTime    @default(now())
  recommendedById String?
  recommendedByText String?
  
  user            User      @relation("UserWatched", fields: [userId], references: [id], onDelete: Cascade)
  media           MediaItem @relation(fields: [mediaId], references: [id])
  recommendedBy   User?     @relation("WatchedRecommendations", fields: [recommendedById], references: [id])

  @@unique([userId, mediaId])
}


model ToWatch {
  id        String      @id @default(cuid())
  userId    String
  mediaId   String
  addedAt   DateTime    @default(now())
  
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     MediaItem @relation(fields: [mediaId], references: [id])

  @@unique([userId, mediaId])
}


model Activity {
  id              String   @id @default(cuid())
  userId          String
  mediaId         String
  type            ActivityType // WATCHED, RATED, REVIEWED
  rating          Float?   // 0-10
  review          String?  @db.Text
  watchedAt       DateTime?
  watchedWith     String?  // Store as JSON string [id1, id2] or names
  recommendedById String?
  recommendedByText String?
  platform        String?  // Netflix, Amazon, etc.
  createdAt       DateTime @default(now())
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media           MediaItem @relation(fields: [mediaId], references: [id])
  recommendedBy   User?     @relation("ActivityRecommendations", fields: [recommendedById], references: [id])
  episodeId       String?
  episode         Episode?  @relation(fields: [episodeId], references: [id])
  comments        Comment[]

  @@unique([userId, mediaId, type], name: "userId_mediaId_type")
}

enum ActivityType {
  WATCHED
  RATED
  REVIEWED
  ADDED_TO_LIST
}

model Comment {
  id         String   @id @default(cuid())
  userId     String
  activityId String?
  episodeId  String?
  personId   Int?     // TMDB Person ID for comments on person pages
  content    String   @db.Text
  createdAt  DateTime @default(now())
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  episode    Episode?  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model Recommendation {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  mediaId     String
  message     String?  @db.Text
  createdAt   DateTime @default(now())
  isRead      Boolean  @default(false)
  
  sender      User      @relation("sentRecommendations", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User      @relation("receivedRecommendations", fields: [receiverId], references: [id], onDelete: Cascade)
  media       MediaItem @relation(fields: [mediaId], references: [id])
}

model Message {
  id        String   @id @default(cuid())
  senderId  String
  receiverId String
  content   String   @db.Text
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)
  
  sender    User     @relation("sentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver  User     @relation("receivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Indicates { // Notification
  id        String   @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  link      String? // Link to activity or user
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  NEW_FOLLOWER
  NEW_COMMENT
  NEW_RECOMMENDATION
  MENTION
  FRIEND_ACTIVITY
}

model Episode {
  id           String   @id @default(cuid())
  mediaId      String
  seasonNumber Int
  episodeNumber Int
  title        String?
  overview     String?  @db.Text
  stillPath    String?
  airDate      DateTime?
  
  media        MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  watchedBy    WatchedEpisode[]
  activities   Activity[]
  comments     Comment[]

  @@unique([mediaId, seasonNumber, episodeNumber])
}

model WatchedEpisode {
  id        String   @id @default(cuid())
  userId    String
  episodeId String
  watchedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
}
