generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                      String           @id @default(cuid())
  name                    String?
  email                   String?          @unique
  emailVerified           DateTime?
  image                   String?
  bio                     String?
  favoriteGenres          String[]
  hasCompletedOnboarding  Boolean          @default(false)
  platforms               String[]
  password                String?
  isPrivate               Boolean          @default(false)
  isSuspended             Boolean          @default(false)
  showActivities          Boolean          @default(true)
  showStats               Boolean          @default(true)
  suspendedAt             DateTime?
  username                String           @unique @default(cuid())
  favoriteMediaIds        String[]
  accounts                Account[]
  achievements            Achievement[]
  activityRecommendations Activity[]       @relation("ActivityRecommendations")
  activities              Activity[]
  comments                Comment[]

  favoritePersons         FavoritePerson[]
  following               Follow[]         @relation("following")
  followedBy              Follow[]         @relation("followedBy")

  notifications           Indicates[]
  receivedMessages        Message[]        @relation("receivedMessages")
  sentMessages            Message[]        @relation("sentMessages")
  receivedRecommendations Recommendation[] @relation("receivedRecommendations")
  sentRecommendations     Recommendation[] @relation("sentRecommendations")
  sessions                Session[]
  toWatch                 ToWatch[]
  watchedRecommendations  Watched[]        @relation("WatchedRecommendations")
  watched                 Watched[]        @relation("UserWatched")
  watchedEpisodes         WatchedEpisode[]
}

model FavoritePerson {
  id          String   @id @default(cuid())
  userId      String
  tmdbId      Int
  name        String
  profilePath String?
  addedAt     DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
}

model Follow {
  followerId  String
  followingId String
  follower    User   @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("followedBy", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MediaItem {
  id              String           @id @default(cuid())
  tmdbId          Int              @unique
  type            MediaType
  title           String
  posterPath      String?
  backdropPath    String?
  overview        String?
  releaseDate     DateTime?
  seasonCount     Int?
  episodeCount    Int?
  genres          String[]
  voteAverage     Float?
  runtime         Int?
  activities      Activity[]

  episodes        Episode[]
  recommendations Recommendation[]
  toWatchBy       ToWatch[]
  watchedBy       Watched[]
}

model Watched {
  id                String    @id @default(cuid())
  userId            String
  mediaId           String
  rating            Float?
  watchedAt         DateTime  @default(now())
  recommendedById   String?
  recommendedByText String?
  media             MediaItem @relation(fields: [mediaId], references: [id])
  recommendedBy     User?     @relation("WatchedRecommendations", fields: [recommendedById], references: [id])
  user              User      @relation("UserWatched", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([userId])
  @@index([mediaId])
}

model ToWatch {
  id      String      @id @default(cuid())
  userId  String
  mediaId String
  addedAt DateTime    @default(now())
  status  WatchStatus @default(PLAN_TO_WATCH)
  media   MediaItem   @relation(fields: [mediaId], references: [id])
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([userId])
  @@index([mediaId])
}

enum WatchStatus {
  PLAN_TO_WATCH
  WATCHING
}

model Activity {
  id                String       @id @default(cuid())
  userId            String
  mediaId           String
  type              ActivityType
  rating            Float?
  review            String?
  watchedAt         DateTime?
  watchedWith       String?
  platform          String?
  createdAt         DateTime     @default(now())
  episodeId         String?
  isSpoiler         Boolean      @default(false)
  votes             Int          @default(0)
  recommendedById   String?
  recommendedByText String?
  episode           Episode?     @relation(fields: [episodeId], references: [id])
  media             MediaItem    @relation(fields: [mediaId], references: [id])
  recommendedBy     User?        @relation("ActivityRecommendations", fields: [recommendedById], references: [id])
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments          Comment[]

  @@unique([userId, mediaId, type, episodeId], name: "userId_mediaId_type_episode")
  @@index([userId])
  @@index([mediaId])
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model Comment {
  id         String    @id @default(cuid())
  userId     String
  activityId String?
  episodeId  String?
  parentId   String?
  content    String
  createdAt  DateTime  @default(now())
  personId   Int?
  isSpoiler  Boolean   @default(false)
  votes      Int       @default(0)
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  episode    Episode?  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentReplies")

  @@index([userId])
  @@index([activityId])
  @@index([episodeId])
  @@index([parentId])
  @@index([createdAt(sort: Desc)])
}

model Recommendation {
  id         String    @id @default(cuid())
  senderId   String
  receiverId String
  mediaId    String
  message    String?
  createdAt  DateTime  @default(now())
  isRead     Boolean   @default(false)
  media      MediaItem @relation(fields: [mediaId], references: [id])
  receiver   User      @relation("receivedRecommendations", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User      @relation("sentRecommendations", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([receiverId])
  @@index([senderId])
  @@index([createdAt(sort: Desc)])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())
  isRead     Boolean  @default(false)
  receiver   User     @relation("receivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("sentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([receiverId])
  @@index([senderId])
  @@index([createdAt(sort: Desc)])
}

model Indicates {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  image     String?
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
}

model Episode {
  id            String           @id @default(cuid())
  mediaId       String
  seasonNumber  Int
  episodeNumber Int
  title         String?
  overview      String?
  stillPath     String?
  airDate       DateTime?
  activities    Activity[]
  comments      Comment[]
  media         MediaItem        @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  watchedBy     WatchedEpisode[]

  @@unique([mediaId, seasonNumber, episodeNumber])
  @@index([mediaId])
}

model WatchedEpisode {
  id        String   @id @default(cuid())
  userId    String
  episodeId String
  watchedAt DateTime @default(now())
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([episodeId])
}

enum MediaType {
  MOVIE
  TV
  PERSON
}

enum ActivityType {
  WATCHED
  RATED
  REVIEWED

}

enum NotificationType {
  NEW_FOLLOWER
  NEW_COMMENT
  NEW_RECOMMENDATION
  MENTION
  FRIEND_ACTIVITY
}



// ============================================
// ACHIEVEMENT / ROZET SİSTEMİ
// ============================================

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  type        AchievementType
  unlockedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

enum AchievementType {
  // İzleme rozetleri
  FIRST_WATCH          // İlk film/dizi izle
  MOVIE_BUFF_10        // 10 film izle
  MOVIE_BUFF_50        // 50 film izle
  MOVIE_BUFF_100       // 100 film izle
  MOVIE_BUFF_250       // 250 film izle
  MOVIE_BUFF_500       // 500 film izle
  TV_BINGER_5          // 5 dizi izle
  TV_BINGER_20         // 20 dizi izle
  TV_BINGER_50         // 50 dizi izle
  EPISODE_MASTER_50    // 50 bölüm izle
  EPISODE_MASTER_200   // 200 bölüm izle
  EPISODE_MASTER_500   // 500 bölüm izle
  MARATHON_RUNNER      // Günde 3+ film izle
  
  // Puanlama rozetleri
  CRITIC_10            // 10 içeriği puanla
  CRITIC_50            // 50 içeriği puanla
  CRITIC_100           // 100 içeriği puanla
  REVIEWER_5           // 5 inceleme yaz
  REVIEWER_25          // 25 inceleme yaz
  
  // Tür rozetleri
  GENRE_EXPLORER       // 5 farklı türden izle
  GENRE_MASTER         // Bir türden 20+ izle
  ALL_ROUNDER          // 10 farklı türden izle
  
  // Sosyal rozetler
  SOCIAL_5             // 5 kişiyi takip et
  SOCIAL_25            // 25 kişiyi takip et
  INFLUENCER_10        // 10 takipçi kazan
  INFLUENCER_50        // 50 takipçi kazan
  RECOMMENDER          // 5 öneri gönder
  COMMENTER_10         // 10 yorum yap
  COMMENTER_50         // 50 yorum yap
  

  
  // Özel rozetler
  EARLY_BIRD           // Platformun erken kullanıcısı
  NIGHT_OWL            // Gece 00:00-05:00 arası izle
  WEEKEND_WARRIOR      // Hafta sonu 10+ içerik izle
}
