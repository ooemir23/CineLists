generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                      String           @id @default(cuid())
  username                String           @unique
  name                    String?
  email                   String?          @unique
  emailVerified           DateTime?
  image                   String?
  bio                     String?
  password                String?
  hasCompletedOnboarding  Boolean          @default(false)
  favoriteGenres          String[]
  platforms               String[]
  accounts                Account[]
  activityRecommendations Activity[]       @relation("ActivityRecommendations")
  activities              Activity[]
  comments                Comment[]
  favoritePersons         FavoritePerson[]
  following               Follow[]         @relation("following")
  followedBy              Follow[]         @relation("followedBy")
  notifications           Indicates[]
  receivedMessages        Message[]        @relation("receivedMessages")
  sentMessages            Message[]        @relation("sentMessages")
  receivedRecommendations Recommendation[] @relation("receivedRecommendations")
  sentRecommendations     Recommendation[] @relation("sentRecommendations")
  sessions                Session[]
  toWatch                 ToWatch[]
  watchedRecommendations  Watched[]        @relation("WatchedRecommendations")
  watched                 Watched[]        @relation("UserWatched")
  watchedEpisodes         WatchedEpisode[]
}

model FavoritePerson {
  id          String   @id @default(cuid())
  userId      String
  tmdbId      Int
  name        String
  profilePath String?
  addedAt     DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
}

model Follow {
  followerId  String
  followingId String
  follower    User   @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("followedBy", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MediaItem {
  id              String           @id @default(cuid())
  tmdbId          Int              @unique
  type            MediaType
  title           String
  posterPath      String?
  backdropPath    String?
  overview        String?
  releaseDate     DateTime?
  runtime         Int?
  seasonCount     Int?
  episodeCount    Int?
  genres          String[]
  voteAverage     Float?
  activities      Activity[]
  episodes        Episode[]
  recommendations Recommendation[]
  toWatchBy       ToWatch[]
  watchedBy       Watched[]
}

model Watched {
  id                String    @id @default(cuid())
  userId            String
  mediaId           String
  rating            Float?
  watchedAt         DateTime  @default(now())
  recommendedById   String?
  recommendedByText String?
  media             MediaItem @relation(fields: [mediaId], references: [id])
  recommendedBy     User?     @relation("WatchedRecommendations", fields: [recommendedById], references: [id])
  user              User      @relation("UserWatched", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
}

model ToWatch {
  id      String    @id @default(cuid())
  userId  String
  mediaId String
  addedAt DateTime  @default(now())
  media   MediaItem @relation(fields: [mediaId], references: [id])
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
}

model Activity {
  id                String       @id @default(cuid())
  userId            String
  mediaId           String
  type              ActivityType
  rating            Float?
  review            String?
  watchedAt         DateTime?
  watchedWith       String?
  recommendedById   String?
  recommendedByText String?
  platform          String?
  createdAt         DateTime     @default(now())
  episodeId         String?
  episode           Episode?     @relation(fields: [episodeId], references: [id])
  media             MediaItem    @relation(fields: [mediaId], references: [id])
  recommendedBy     User?        @relation("ActivityRecommendations", fields: [recommendedById], references: [id])
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments          Comment[]

  @@unique([userId, mediaId, type], name: "userId_mediaId_type")
}

model Comment {
  id         String    @id @default(cuid())
  userId     String
  activityId String?
  episodeId  String?
  personId   Int?
  content    String
  createdAt  DateTime  @default(now())
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  episode    Episode?  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recommendation {
  id         String    @id @default(cuid())
  senderId   String
  receiverId String
  mediaId    String
  message    String?
  createdAt  DateTime  @default(now())
  isRead     Boolean   @default(false)
  media      MediaItem @relation(fields: [mediaId], references: [id])
  receiver   User      @relation("receivedRecommendations", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User      @relation("sentRecommendations", fields: [senderId], references: [id], onDelete: Cascade)
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())
  isRead     Boolean  @default(false)
  receiver   User     @relation("receivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("sentMessages", fields: [senderId], references: [id], onDelete: Cascade)
}

model Indicates {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Episode {
  id            String           @id @default(cuid())
  mediaId       String
  seasonNumber  Int
  episodeNumber Int
  title         String?
  overview      String?
  stillPath     String?
  airDate       DateTime?
  activities    Activity[]
  comments      Comment[]
  media         MediaItem        @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  watchedBy     WatchedEpisode[]

  @@unique([mediaId, seasonNumber, episodeNumber])
}

model WatchedEpisode {
  id        String   @id @default(cuid())
  userId    String
  episodeId String
  watchedAt DateTime @default(now())
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
}

enum MediaType {
  MOVIE
  TV
  PERSON
}

enum ActivityType {
  WATCHED
  RATED
  REVIEWED
  ADDED_TO_LIST
}

enum NotificationType {
  NEW_FOLLOWER
  NEW_COMMENT
  NEW_RECOMMENDATION
  MENTION
  FRIEND_ACTIVITY
}
